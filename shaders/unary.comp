#version 450
// SPDX-License-Identifier: LGPL-3.0-or-later
// out[i] = f(a[i]).
// op: 0 relu, 1 scale (a * s), 2 add scalar (a + s), 3 exp, 4 tanh,
//     5 sigmoid, 6 copy.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer A { float a[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Out { float o[]; };

layout(push_constant) uniform Push { uint n; uint op; float s; } p;

void main() {
    // Grid-stride loop: any n, whatever the number of workgroups.
    uint stride = gl_NumWorkGroups.x * 256;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
    float x = a[i];
    float r;
    switch (p.op) {
        case 0: r = max(x, 0.0); break;
        case 1: r = x * p.s; break;
        case 2: r = x + p.s; break;
        case 3: r = exp(x); break;
        case 4: r = tanh(x); break;
        case 5: r = 1.0 / (1.0 + exp(-x)); break;
        default: r = x; break;
    }
    o[i] = r;
    }
}
