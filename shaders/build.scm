;;; guile-vulkan --- Vulkan bindings for GNU Guile
;;; SPDX-License-Identifier: LGPL-3.0-or-later
;;;
;;; Compiles shaders/*.comp to SPIR-V with glslangValidator and writes
;;; vulkan/compute/shaders.scm, which holds each as a bytevector, so the
;;; compute module needs no files besides Scheme modules.  Run from the
;;; repository root:
;;;
;;;   guile shaders/build.scm

(use-modules (ice-9 binary-ports)
             (rnrs bytevectors)
             (ice-9 format)
             (ice-9 match)
             (srfi srfi-1))

(define shaders '("matmul" "binary" "unary" "softmax" "sum-rows"))
(define output "vulkan/compute/shaders.scm")

(define (compile name)
  (let* ((port (mkstemp "/tmp/guile-vulkan-shader-XXXXXX"))
         (spv (port-filename port)))
    (close-port port)
    (unless (zero? (system* "glslangValidator" "-V" "--quiet"
                            (string-append "shaders/" name ".comp") "-o" spv))
      (error "glslangValidator failed on" name))
    (let ((code (call-with-input-file spv get-bytevector-all #:binary #t)))
      (delete-file spv)
      code)))

(define (write-bytevector bv port)
  (display "#vu8(" port)
  (let loop ((i 0))
    (when (< i (bytevector-length bv))
      (when (and (> i 0) (zero? (modulo i 24)))
        (display "\n     " port))
      (format port "~:[ ~;~]~d" (or (zero? i) (zero? (modulo i 24))) (bytevector-u8-ref bv i))
      (loop (+ i 1))))
  (display ")" port))

(call-with-output-file output
  (lambda (port)
    (format port ";;; Generated by shaders/build.scm from shaders/*.comp -- do not edit.~%")
    (format port ";;; SPDX-License-Identifier: LGPL-3.0-or-later~%~%")
    (format port "(define-module (vulkan compute shaders)~%  #:export (~{~a-spirv~^ ~}))~%" shaders)
    (for-each (lambda (name)
                (let ((code (compile name)))
                  (format port "~%;; shaders/~a.comp, ~a bytes of SPIR-V~%(define ~a-spirv~%  "
                          name (bytevector-length code) name)
                  (write-bytevector code port)
                  (format port ")~%")))
              shaders)))

(format #t "wrote ~a (~{~a~^, ~})~%" output shaders)
