;;; guile-vulkan --- Vulkan bindings for GNU Guile
;;; SPDX-License-Identifier: LGPL-3.0-or-later
;;;
;;; A native Wayland window for the examples, with only libwayland-client:
;;; one xdg-shell toplevel, its size, the close request and the keyboard.
;;;
;;; libwayland-client does not include the xdg-shell protocol (normally
;;; generated by wayland-scanner), so its interface tables are built here,
;;; with define-vk-struct.  Requests go through the non-variadic
;;; wl_proxy_marshal_array_flags; events arrive in Guile procedures made C
;;; callable with procedure->pointer.  Keys are raw evdev codes (no
;;; libxkbcommon), which is enough for Esc, the arrows and space.
;;;
;;; The window has no decorations: xdg-shell leaves them to the client.

(define-module (examples wayland)
  #:use-module (vulkan runtime)
  #:use-module (system foreign)
  #:use-module (system foreign-library)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (ice-9 match)
  #:export (wayland-open-window wayland-close-window wayland-poll-events
            wayland-window-display wayland-window-surface wayland-window-size
            wayland-window-closed? wayland-key-down?
            key-escape key-space key-up key-left key-right key-down))

(define libwayland (load-foreign-library "libwayland-client.so.0"))
(define (wl name ret args) (pointer->procedure ret (foreign-library-pointer libwayland name) args))
(define (wl-data name) (pointer-address (foreign-library-pointer libwayland name)))

;; evdev key codes (linux/input-event-codes.h)
(define key-escape 1)
(define key-space 57)
(define key-up 103)
(define key-left 105)
(define key-right 106)
(define key-down 108)

(define wl-display-connect (wl "wl_display_connect" uintptr_t (list uintptr_t)))
(define wl-display-disconnect (wl "wl_display_disconnect" void (list uintptr_t)))
(define wl-display-roundtrip (wl "wl_display_roundtrip" int (list uintptr_t)))
(define wl-display-dispatch-pending (wl "wl_display_dispatch_pending" int (list uintptr_t)))
(define wl-display-prepare-read (wl "wl_display_prepare_read" int (list uintptr_t)))
(define wl-display-read-events (wl "wl_display_read_events" int (list uintptr_t)))
(define wl-display-cancel-read (wl "wl_display_cancel_read" void (list uintptr_t)))
(define wl-display-flush (wl "wl_display_flush" int (list uintptr_t)))
(define wl-display-get-fd (wl "wl_display_get_fd" int (list uintptr_t)))
(define wl-proxy-get-version (wl "wl_proxy_get_version" uint32 (list uintptr_t)))
(define wl-proxy-destroy (wl "wl_proxy_destroy" void (list uintptr_t)))
(define wl-proxy-add-listener (wl "wl_proxy_add_listener" int (list uintptr_t uintptr_t uintptr_t)))
(define %marshal (wl "wl_proxy_marshal_array_flags" uintptr_t
                     (list uintptr_t uint32 uintptr_t uint32 uint32 uintptr_t)))

(define wl-registry-interface (wl-data "wl_registry_interface"))
(define wl-compositor-interface (wl-data "wl_compositor_interface"))
(define wl-surface-interface (wl-data "wl_surface_interface"))
(define wl-seat-interface (wl-data "wl_seat_interface"))
(define wl-keyboard-interface (wl-data "wl_keyboard_interface"))
(define wl-output-interface (wl-data "wl_output_interface"))

;;; ------------------------------------------------------------------
;;; Requests: (request proxy opcode new-interface flags arg ...), each arg
;;; one union wl_argument (8 bytes): an integer, an address or a string.

(define marshal-flag-destroy 1)
(define keep (make-hash-table))           ; objects C refers to, kept alive

(define (request proxy opcode interface flags . args)
  (let ((bv (make-bytevector (* 8 (max 1 (length args))) 0))
        (strings '()))
    (for-each (lambda (arg i)
                (bytevector-u64-native-set!
                 bv (* 8 i)
                 (cond ((string? arg)
                        (let ((c (vk-c-string arg)))
                          (set! strings (cons c strings))
                          (vk-address c)))
                       ((negative? arg) (+ arg (expt 2 64)))
                       (else arg))))
              args (iota (length args)))
    (let ((r (%marshal proxy opcode (or interface 0) (wl-proxy-get-version proxy) flags (vk-address bv))))
      (list strings bv)                   ; keep them alive until here
      r)))

;;; ------------------------------------------------------------------
;;; The xdg-shell interfaces (stable, version 1 subset).

(define-vk-struct wl-message 24 (name (ptr) 0) (signature (ptr) 8) (types (ptr) 16))
(define-vk-struct wl-interface 40
  (name (ptr) 0) (version (s32) 8) (method-count (s32) 12) (methods (ptr) 16)
  (event-count (s32) 24) (events (ptr) 32))

;; An interface's wl_interface, filled in later (messages refer to others).
(define (make-interface) (make-vk wl-interface))

(define (types-array . interfaces)        ; wl_interface *[], #f for none
  (let ((bv (make-bytevector (* 8 (max 1 (length interfaces))) 0)))
    (for-each (lambda (iface i)
                (bytevector-u64-native-set! bv (* 8 i)
                                            (cond ((not iface) 0)
                                                  ((bytevector? iface) (vk-address iface))
                                                  (else iface))))
              interfaces (iota (length interfaces)))
    bv))

(define null-types (apply types-array (make-list 8 #f)))

;; MESSAGES: ((name signature types) ...), TYPES a bytevector or #f.
(define (messages-array messages)
  (let ((bv (make-vk wl-message (max 1 (length messages)))))
    (for-each (match-lambda*
                (((name signature types) i)
                 (vk-set! wl-message (name) bv i name)
                 (vk-set! wl-message (signature) bv i signature)
                 (vk-set! wl-message (types) bv i (or types null-types))))
              messages (iota (length messages)))
    bv))

(define (fill-interface! iface name version requests events)
  (vk-set! wl-interface (name) iface name)
  (vk-set! wl-interface (version) iface version)
  (vk-set! wl-interface (method-count) iface (length requests))
  (vk-set! wl-interface (methods) iface (messages-array requests))
  (vk-set! wl-interface (event-count) iface (length events))
  (vk-set! wl-interface (events) iface (messages-array events)))

(define xdg-wm-base-interface (make-interface))
(define xdg-surface-interface (make-interface))
(define xdg-toplevel-interface (make-interface))

(fill-interface! xdg-wm-base-interface "xdg_wm_base" 1
                 `(("destroy" "" #f)
                   ("create_positioner" "n" #f)
                   ("get_xdg_surface" "no" ,(types-array xdg-surface-interface wl-surface-interface))
                   ("pong" "u" #f))
                 '(("ping" "u" #f)))
(fill-interface! xdg-surface-interface "xdg_surface" 1
                 `(("destroy" "" #f)
                   ("get_toplevel" "n" ,(types-array xdg-toplevel-interface))
                   ("get_popup" "n?oo" ,(types-array #f xdg-surface-interface #f))
                   ("set_window_geometry" "iiii" #f)
                   ("ack_configure" "u" #f))
                 '(("configure" "u" #f)))
(fill-interface! xdg-toplevel-interface "xdg_toplevel" 1
                 `(("destroy" "" #f)
                   ("set_parent" "?o" ,(types-array xdg-toplevel-interface))
                   ("set_title" "s" #f)
                   ("set_app_id" "s" #f)
                   ("show_window_menu" "ouii" ,(types-array wl-seat-interface #f #f #f))
                   ("move" "ou" ,(types-array wl-seat-interface #f))
                   ("resize" "ouu" ,(types-array wl-seat-interface #f #f))
                   ("set_max_size" "ii" #f)
                   ("set_min_size" "ii" #f)
                   ("set_maximized" "" #f)
                   ("unset_maximized" "" #f)
                   ("set_fullscreen" "?o" ,(types-array wl-output-interface))
                   ("unset_fullscreen" "" #f)
                   ("set_minimized" "" #f))
                 '(("configure" "iia" #f)
                   ("close" "" #f)))

;;; ------------------------------------------------------------------
;;; Listeners: arrays of C function pointers to Guile procedures.

(define (listen! proxy . callbacks)       ; callbacks: (procedure return-type arg-types)
  (let ((table (make-bytevector (* 8 (length callbacks)) 0))
        (pointers (map (match-lambda ((proc ret args) (procedure->pointer ret proc args))) callbacks)))
    (for-each (lambda (p i) (bytevector-u64-native-set! table (* 8 i) (pointer-address p)))
              pointers (iota (length pointers)))
    (hash-set! keep table pointers)       ; C keeps calling these
    (wl-proxy-add-listener proxy (vk-address table) 0)))

;;; ------------------------------------------------------------------
;;; The window.

(define-record-type <wayland-window>
  (%make-window display registry compositor wm-base seat surface xdg-surface toplevel)
  wayland-window?
  (display wayland-window-display)
  (registry window-registry)
  (compositor window-compositor)
  (wm-base window-wm-base)
  (seat window-seat set-window-seat!)
  (surface wayland-window-surface)
  (xdg-surface window-xdg-surface)
  (toplevel window-toplevel)
  (keyboard window-keyboard set-window-keyboard!)
  (size wayland-window-size set-window-size!)
  (configured? window-configured? set-window-configured?!)
  (closed? wayland-window-closed? set-window-closed?!)
  (keys window-keys set-window-keys!)       ; evdev codes held down
  (on-resize window-on-resize set-window-on-resize!))

(define (wayland-key-down? w key) (and (memv key (window-keys w)) #t))

(define* (wayland-open-window title width height #:key (app-id "guile-vulkan"))
  "Open a WIDTHxHEIGHT toplevel window titled TITLE and wait until the
compositor has configured it."
  (let ((display (wl-display-connect 0)))
    (when (zero? display) (error "cannot connect to a Wayland display (is WAYLAND_DISPLAY set?)"))
    (let* ((globals '())
           (registry (request display 1 wl-registry-interface 0 0)))   ; wl_display.get_registry
      (listen! registry
               (list (lambda (data registry name interface version)
                       (set! globals (cons (list (pointer->string interface) name version) globals)))
                     void (list '* uintptr_t uint32 '* uint32))
               (list (lambda (data registry name) #f) void (list '* uintptr_t uint32)))
      (wl-display-roundtrip display)
      (let* ((global (lambda (name) (or (assoc name globals) (error "the compositor lacks" name))))
             (bind (lambda (name interface version)        ; wl_registry.bind "usun"
                     (match (global name)
                       ((_ id offered)
                        (%bind registry id name interface (min version offered))))))
             (compositor (bind "wl_compositor" wl-compositor-interface 4))
             (wm-base (bind "xdg_wm_base" (vk-address xdg-wm-base-interface) 1))
             (seat (and (assoc "wl_seat" globals) (bind "wl_seat" wl-seat-interface 1)))
             (surface (request compositor 0 wl-surface-interface 0 0))     ; create_surface
             (xdg-surface (request wm-base 2 (vk-address xdg-surface-interface) 0 0 surface))
             (toplevel (request xdg-surface 1 (vk-address xdg-toplevel-interface) 0 0))
             (w (%make-window display registry compositor wm-base seat surface xdg-surface toplevel)))
        (set-window-size! w (cons width height))
        (set-window-configured?! w #f)
        (set-window-closed?! w #f)
        (set-window-keys! w '())
        (set-window-keyboard! w #f)
        (set-window-on-resize! w (lambda (width height) #f))
        (listen! wm-base                                          ; ping -> pong
                 (list (lambda (data base serial) (request wm-base 3 #f 0 serial))
                       void (list '* uintptr_t uint32)))
        (listen! xdg-surface                                      ; configure -> ack
                 (list (lambda (data s serial)
                         (request xdg-surface 4 #f 0 serial)
                         (set-window-configured?! w #t))
                       void (list '* uintptr_t uint32)))
        (listen! toplevel
                 (list (lambda (data t width height states)     ; 0 means "you choose"
                         (when (and (positive? width) (positive? height)
                                    (not (equal? (cons width height) (wayland-window-size w))))
                           (set-window-size! w (cons width height))
                           ((window-on-resize w) width height)))
                       void (list '* uintptr_t int32 int32 '*))
                 (list (lambda (data t) (set-window-closed?! w #t))
                       void (list '* uintptr_t)))
        (when seat
          (listen! seat
                   (list (lambda (data s capabilities)
                           (when (and (logtest capabilities 2) (not (window-keyboard w)))
                             (let ((keyboard (request seat 1 wl-keyboard-interface 0 0)))
                               (set-window-keyboard! w keyboard)
                               (listen-keyboard! w keyboard))))
                         void (list '* uintptr_t uint32))))
        (request toplevel 2 #f 0 title)                          ; set_title
        (request toplevel 3 #f 0 app-id)                         ; set_app_id
        (request surface 6 #f 0)                                 ; wl_surface.commit
        (let loop ()                                             ; until configured
          (unless (window-configured? w)
            (when (< (wl-display-roundtrip display) 0) (error "Wayland connection failed"))
            (loop)))
        w))))

;; wl_registry.bind "usun": the new object gets the requested VERSION
;; (request would give it the registry's).
(define (%bind registry id name interface version)
  (let ((c-name (vk-c-string name))
        (args (make-bytevector 32 0)))
    (bytevector-u64-native-set! args 0 id)
    (bytevector-u64-native-set! args 8 (vk-address c-name))
    (bytevector-u64-native-set! args 16 version)
    (let ((r (%marshal registry 0 interface version 0 (vk-address args))))
      (list c-name args)                  ; keep them alive until here
      r)))

(define (listen-keyboard! w keyboard)
  (listen! keyboard
           (list (lambda (data k format fd size) (close-fdes fd))          ; keymap: not needed
                 void (list '* uintptr_t uint32 int32 uint32))
           (list (lambda (data k serial surface keys) #f)                    ; enter
                 void (list '* uintptr_t uint32 '* '*))
           (list (lambda (data k serial surface) (set-window-keys! w '())) ; leave
                 void (list '* uintptr_t uint32 '*))
           (list (lambda (data k serial time key state)                    ; key
                   (set-window-keys! w (if (= state 1)
                                           (lset-adjoin = (window-keys w) key)
                                           (delete key (window-keys w)))))
                 void (list '* uintptr_t uint32 uint32 uint32 uint32))
           (list (lambda (data k serial depressed latched locked group) #f) ; modifiers
                 void (list '* uintptr_t uint32 uint32 uint32 uint32 uint32))))

(define* (wayland-poll-events w #:key (on-resize #f))
  "Read and dispatch whatever events are waiting, without blocking.
Returns #f once the compositor asked to close the window."
  (when on-resize (set-window-on-resize! w on-resize))
  (let ((display (wayland-window-display w)))
    (let loop ()
      (unless (zero? (wl-display-prepare-read display))
        (wl-display-dispatch-pending display)
        (loop)))
    (wl-display-flush display)
    (match (select (list (wl-display-get-fd display)) '() '() 0)
      (((_ . _) _ _) (wl-display-read-events display))
      (_ (wl-display-cancel-read display)))
    (wl-display-dispatch-pending display)
    (not (wayland-window-closed? w))))

(define (wayland-close-window w)
  (let ((destroy (lambda (proxy) (request proxy 0 #f marshal-flag-destroy))))
    (destroy (window-toplevel w))
    (destroy (window-xdg-surface w))
    (destroy (wayland-window-surface w))
    (destroy (window-wm-base w))
    (when (window-keyboard w) (wl-proxy-destroy (window-keyboard w)))
    (when (window-seat w) (wl-proxy-destroy (window-seat w)))
    (wl-proxy-destroy (window-compositor w))
    (wl-proxy-destroy (window-registry w))
    (wl-display-roundtrip (wayland-window-display w))
    (wl-display-disconnect (wayland-window-display w))))
